{
  "name": "brightloop",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace @brightloop/frontend",
    "dev:backend": "npm run dev --workspace @brightloop/backend",
